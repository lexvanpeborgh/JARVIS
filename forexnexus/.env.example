# Kopieer naar je hostingplatform als RUNTIME SECRETS (niet committen).
# Wachtwoord voor de privé-app (of FNX_ACCESS_PASSWORD_HASH = scrypt$<salt>$<hash>).
FNX_ACCESS_PASSWORD=kies-een-lang-uniek-wachtwoord
# 32 willekeurige bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FNX_MASTER_KEY=
# Alleen nodig als een externe watchdog /api/worker/tick aanroept (HMAC).
FNX_WORKER_SECRET=
# Zet op 1 achter HTTPS (Secure-cookie + HSTS).
FNX_COOKIE_SECURE=1
# Opslaglocatie (persistent volume).
FNX_DATA_DIR=/data
PORT=8080
# Alleen achter een uitgaande HTTP-proxy:
# NODE_USE_ENV_PROXY=1
#
# OANDA-token, Telegram-token en Gemini-key worden NIET hier gezet maar
# versleuteld ingevoerd via Verbindingen in de app.
